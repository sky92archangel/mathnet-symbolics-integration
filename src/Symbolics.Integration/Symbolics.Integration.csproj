<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <AssemblyName>MathNet.Symbolics.Integration</AssemblyName>
    <RootNamespace>MathNet.Symbolics.Integration</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>MathNet.Symbolics.Integration</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>Math.NET Symbolics Integration</Title>
    <Description>Pure C# symbolic integration engine, ported from SymPy's manualintegrate module. No external dependencies.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
